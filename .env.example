# Application
APP_NAME=Lively API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (Neon Postgres or local)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lively

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email verification
VERIFICATION_CODE_EXPIRE_MINUTES=15
VERIFICATION_CODE_LENGTH=4
# Set false in production once email delivery is confirmed
INCLUDE_VERIFICATION_CODE_IN_RESPONSE=true

# Family invite codes: alphanumeric (default) or numeric; length is always 6 for MVP
INVITE_CODE_FORMAT=alphanumeric
INVITE_CODE_LENGTH=6

# Campaign Monitor transactional email
# API key: Account Settings → API Keys
# Authenticate sending domain and enable custom auth for transactional email
# clientID is only required for account-level API keys
CAMPAIGN_MONITOR_API_KEY=
CAMPAIGN_MONITOR_SENDER_EMAIL=support@areyoulively.com
CAMPAIGN_MONITOR_SENDER_NAME=Lively
CAMPAIGN_MONITOR_CLIENT_ID=
