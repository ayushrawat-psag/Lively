# Application
APP_NAME=Lively API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (Neon Postgres or local)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lively

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email verification
VERIFICATION_CODE_EXPIRE_MINUTES=15
VERIFICATION_CODE_LENGTH=4
# Set false in production once Brevo delivery is confirmed
INCLUDE_VERIFICATION_CODE_IN_RESPONSE=true

# Brevo transactional email
# Create API key: Brevo → Settings → SMTP & API → API Keys
# Verify sender: Brevo → Settings → Senders, Domains & Dedicated IPs
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Lively
