{
    "info": {
      "name": "Lively Auth API",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "baseUrl", "value": "https://dev-lively-backend.onrender.com" },
      { "key": "email", "value": "john@example.com" },
      { "key": "password", "value": "Demo@123" },
      { "key": "verificationCode", "value": "" },
      { "key": "token", "value": "" }
    ],
    "item": [
      {
        "name": "Health",
        "request": {
          "method": "GET",
          "header": [],
          "url": "{{baseUrl}}/health"
        }
      },
      {
        "name": "Signup",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"guardian\": true,\n  \"acceptedTerms\": true\n}"
          },
          "url": "{{baseUrl}}/api/v1/auth/signup"
        }
      },
      {
        "name": "Login (before verify)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
          },
          "url": "{{baseUrl}}/api/v1/auth/login"
        }
      },
      {
        "name": "Verify Email",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
          },
          "url": "{{baseUrl}}/api/v1/auth/email/verify"
        }
      },
      {
        "name": "Login (after verify)",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
          },
          "url": "{{baseUrl}}/api/v1/auth/login"
        }
      },
      {
        "name": "Resend Verification",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"email\": \"{{email}}\"\n}"
          },
          "url": "{{baseUrl}}/api/v1/auth/email/resend"
        }
      }
    ]
  }